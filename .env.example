# ─────────────────────────────────────────────
#  紫微斗数自建站 · 环境配置
#  修改后执行 ./restart.sh 生效
# ─────────────────────────────────────────────

# 对外端口（默认 28763）。改这里即可换端口，例如 8080
HOST_PORT=28763

# ── 构建加速（只影响 docker build，不影响运行）──
# 国内服务器强烈建议保留这两项：Debian 官方源与 npm 官方源在国内极慢，
# apt 装 75 MB 编译工具能跑到十几分钟，npm 更久。
# 海外服务器可以把这两行删掉或留空，走官方源。
APT_MIRROR=mirrors.aliyun.com
NPM_REGISTRY=https://registry.npmmirror.com

# 小内存机器（≤2 GB）构建 next 时容易被 OOM 杀掉，取消下面这行注释限制堆上限。
# 若加了 swap 后仍失败，再启用它；内存充足时留空即可。
# BUILD_NODE_OPTIONS=--max-old-space-size=1024

# ── 大模型（OpenAI 兼容协议，对接 PackyCode）──
# 注意：必须使用「支持第三方接入」的分组（cc-sale / cc-expensive /
#      claude-officially / aws-q / azure-officially / deepseek-sale 等）。
#      CC 分组与 Codex 分组明确不支持第三方，接入会触发环境审查并封号。
PACKYCODE_BASE_URL=https://www.packyapi.com/v1
PACKYCODE_API_KEY=
PACKYCODE_MODEL=claude-sonnet-4-5

# 单次 AI 请求超时（毫秒）
AI_TIMEOUT_MS=90000

# 每个 IP 每小时 AI 追问次数上限。填 0 表示不限（不建议，公开站会被刷爆额度）
AI_RATE_LIMIT=30

# 站点地址，仅用于分享链接展示
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:28763
