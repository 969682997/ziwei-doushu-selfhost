# ─────────────────────────────────────────────
#  紫微斗数自建站 · 环境配置
#  修改后执行 ./restart.sh 生效
# ─────────────────────────────────────────────

# 对外端口（默认 28763）。改这里即可换端口，例如 8080
HOST_PORT=28763

# ── 大模型（OpenAI 兼容协议，对接 PackyCode）──
# 注意：必须使用「支持第三方接入」的分组（cc-sale / cc-expensive /
#      claude-officially / aws-q / azure-officially / deepseek-sale 等）。
#      CC 分组与 Codex 分组明确不支持第三方，接入会触发环境审查并封号。
PACKYCODE_BASE_URL=https://www.packyapi.com/v1
PACKYCODE_API_KEY=
PACKYCODE_MODEL=claude-sonnet-4-5

# 单次 AI 请求超时（毫秒）
AI_TIMEOUT_MS=90000

# 每个 IP 每小时 AI 追问次数上限。填 0 表示不限（不建议，公开站会被刷爆额度）
AI_RATE_LIMIT=30

# 站点地址，仅用于分享链接展示
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:28763
